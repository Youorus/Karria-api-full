# Tout ce qui n'a rien à faire dans le contexte de build. Un contexte
# léger, c'est un build rapide — et surtout aucun secret embarqué par
# inadvertance dans une couche d'image.

.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]

.env
.env.*
!.env.example

.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage*
htmlcov/

tests/
docs/
# `scripts/` n'est PAS exclu : l'image d'exploitation en a besoin.
# Le provisionnement des buckets et le diagnostic s'y trouvent, et
# l'API refuse de démarrer tant que les buckets n'existent pas —
# sans ces fichiers à bord, un environnement déployé est impossible
# à mettre en service.
*.md
!README.md

.idea/
.vscode/
.DS_Store
