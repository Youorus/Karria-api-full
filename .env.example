# =====================================================================
# Modèle de configuration locale. Copier vers `.env` (jamais versionné).
#
# Les préfixes correspondent au découpage de `karria.shared.config` :
# chaque bloc de Settings lit son propre préfixe. Aucun réglage métier
# ne doit apparaître ici — la configuration décrit l'ENVIRONNEMENT,
# pas les règles du produit. La V1 pilotait `OPENAI_DAILY_BUDGET_EUR`
# par variable d'environnement : c'est exactement ce qu'on ne refait pas.
#
# Ce fichier ne porte que les blocs du socle. Un module qui a besoin
# d'un réglage (clé Gemini, source d'offres…) ajoute son bloc ici dans
# le commit qui le crée.
# =====================================================================

# --- Application -----------------------------------------------------
APP__ENVIRONMENT=local          # local | test | staging | production
APP__DEBUG=true
APP__API_PREFIX=/api/v1
APP__PUBLIC_URL=http://localhost:8000

# --- Base de données -------------------------------------------------
DB__URL=postgres://karria:karria@localhost:5432/karria
DB__MIN_POOL_SIZE=1
DB__MAX_POOL_SIZE=10

# --- Sécurité --------------------------------------------------------
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECURITY__SECRET_KEY=change-me-en-local-et-jamais-en-production
SECURITY__ALLOWED_ORIGINS=["http://localhost:3000"]
SECURITY__ALLOWED_HOSTS=["*"]

# Poivre ajouté avant de hacher les jetons de session et les codes de
# connexion. DISTINCT de SECRET_KEY : deux secrets, deux usages, deux
# rotations.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# ⚠️ Le changer déconnecte tout le monde. C'est d'ailleurs le geste à faire
# si l'on soupçonne une fuite de la base.
SECURITY__TOKEN_PEPPER=poivre-de-developpement-a-remplacer

# --- Stockage objet --------------------------------------------------
# Fournisseur : scaleway | aws | cloudflare_r2 | ovh | backblaze | minio | memory
# L'endpoint est DÉRIVÉ du fournisseur et de la région : ne le saisis pas à
# la main. Une URL recopiée dans un `.env` est une faute de frappe en
# attente, et elle n'échoue qu'au premier envoi de fichier.
#
# En local : MinIO (`make db-up`), même protocole que la production.
# `memory` existe pour les tests unitaires ; il perd tout au redémarrage et
# la configuration le refuse hors du local.
STORAGE__PROVIDER=minio
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=minioadmin
STORAGE__BUCKET_PREFIX=karria
STORAGE__PRESIGN_TTL_SECONDS=3600
STORAGE__MAX_UPLOAD_BYTES=26214400

# En production (Scaleway, comme la V1) :
#   STORAGE__PROVIDER=scaleway
#   STORAGE__REGION=fr-par          # → https://s3.fr-par.scw.cloud
#   STORAGE__ACCESS_KEY=SCW…        # clé DÉDIÉE à ce projet, jamais partagée
#   STORAGE__SECRET_KEY=…           # affichée une seule fois à la création

# --- Observabilité ---------------------------------------------------
OBSERVABILITY__LOG_LEVEL=DEBUG
OBSERVABILITY__LOG_FORMAT=console   # console (dev, lisible) | json (prod)

# --- Envoi d'e-mails -------------------------------------------------
# La connexion à Karria passe par un code envoyé par e-mail : c'est le
# seul canal. `console` affiche le message dans les journaux — pratique
# en local, et refusé au démarrage en production, où un code affiché
# n'atteint jamais son destinataire.
MAIL__PROVIDER=console          # console | smtp

# Renseigner uniquement si MAIL__PROVIDER=smtp. Port 587 avec STARTTLS ;
# le certificat du serveur est vérifié (voir `shared/mail/smtp.py`) et
# cette vérification ne se désactive jamais.
#
# MAIL__USERNAME et MAIL__FROM_ADDRESS doivent être la MÊME adresse : la
# plupart des fournisseurs refusent un `From:` qui n'appartient pas au
# compte authentifié, et SPF le sanctionnerait côté destinataire.
MAIL__HOST=
MAIL__PORT=587
MAIL__USERNAME=
# JAMAIS de vraie valeur ici : ce fichier est versionné. Le mot de passe se
# pose dans le `.env` local et dans les variables du serveur.
MAIL__PASSWORD=
MAIL__FROM_ADDRESS=
MAIL__FROM_NAME=Karria

# URL publique de l'application — c'est là que mènent les boutons des
# e-mails, jamais vers l'API. Injectée dans tous les gabarits.
MAIL__APP_URL=http://localhost:3000

# Domaine des `Message-ID`. Il doit correspondre à celui de l'adresse
# d'envoi : une incohérence est un signal négatif pour les filtres.
MAIL__MESSAGE_ID_DOMAIN=karria.fr

# --- Connexion Apple et Google (module `identity`, ADR-0011) -----------
# Des AUDIENCES, pas des secrets : ces identifiants figurent déjà dans
# l'application. Ce qui protège, c'est que l'API refuse tout jeton émis
# pour une autre audience. Google émet un client PAR PLATEFORME : recopier
# ici les valeurs de `EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID` et
# `EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID` du `.env` de `karria_app`. Sans
# aucune valeur, la connexion Google répond « indisponible » (503) et le
# démarrage l'avertit sans bloquer.
SOCIAL__GOOGLE_IOS_CLIENT_ID=
SOCIAL__GOOGLE_WEB_CLIENT_ID=
SOCIAL__GOOGLE_ANDROID_CLIENT_ID=
# Le bundle identifier iOS, audience des jetons Apple. Ne change pas.
SOCIAL__APPLE_CLIENT_ID=com.karria.app

# --- Notifications push (module `devices`, ADR-0012) -------------------
# Le service push d'Expo. L'URL ne change que pour viser un faux serveur
# en recette. Le jeton d'accès n'est requis que si la « sécurité renforcée
# des notifications » est activée sur le projet Expo ; vide sinon.
PUSH__EXPO_API_URL=https://exp.host/--/api/v2
PUSH__EXPO_ACCESS_TOKEN=
PUSH__REQUEST_TIMEOUT_SECONDS=10

# --- Gemini (module cv) ----------------------------------------------
# Une seule clé pour l'interprétation des réponses, la transcription,
# l'extraction d'un CV existant et le portrait amélioré. Console Google AI
# Studio → « Get API key ». JAMAIS de vraie valeur ici : ce fichier est
# versionné. Vide, les routes concernées répondent 503 `ai_unavailable`
# et tout le reste fonctionne ; en déployé, le démarrage journalise un
# avertissement (`config.gemini_disabled`).
GEMINI__API_KEY=
# Modèles, relevés sur la liste du fournisseur le 2026-10-21 (ADR-0013).
# Changer de modèle est un geste de configuration, pas une livraison.
GEMINI__TEXT_MODEL=gemini-3.8-flash
GEMINI__IMAGE_MODEL=gemini-3.1-flash-image
GEMINI__REQUEST_TIMEOUT_SECONDS=60
GEMINI__IMAGE_TIMEOUT_SECONDS=90
